{
  "name": "@lexnexus/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "generate": "prisma generate --schema prisma/schema.prisma",
    "import:mindmap": "tsx prisma/import-mind-map.ts",
    "import:oab": "tsx prisma/import-oab.ts",
    "import:oab:sample": "tsx prisma/import-oab.ts --max-exams 2",
    "import:pci": "tsx prisma/import-pci.ts",
    "import:pci:sample": "tsx prisma/import-pci.ts --category contratos --max-pages 1 --max-exams 3",
    "import:pci:daily": "tsx prisma/import-pci.ts --daily"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.14",
    "prisma": "^6.14.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
